{
  "name": "g-harness",
  "version": "0.2.0",
  "description": "AI 驱动的工程化规范框架 + CLI 工具（Harness Engineering）",
  "type": "module",
  "bin": {
    "g-harness": "./dist/core/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/presets",
    "src/templates"
  ],
  "scripts": {
    "build": "tsc && node tools/scripts/copy-assets.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "link": "pnpm run build && npm link",
    "unlink": "npm unlink -g g-harness",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "ai",
    "claude",
    "engineering",
    "conventions",
    "harness",
    "scaffolding",
    "rules"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.3"
  },
  "optionalDependencies": {
    "@langchain/anthropic": "^1.3.27",
    "@langchain/core": "^1.1.41",
    "@langchain/deepseek": "^1.0.24",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "deepagents": "1.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.5"
  }
}
