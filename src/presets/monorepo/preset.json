{
  "name": "monorepo",
  "description": "Monorepo 工程预设（Turborepo / Nx + pnpm workspace）",
  "techStack": {
    "language": "TypeScript",
    "runtime": "Node.js 20+",
    "framework": "Turborepo / Nx",
    "buildTool": "Turborepo / Nx + tsup / tsc",
    "testRunner": "Vitest",
    "packageManager": "pnpm (workspace)"
  },
  "variables": {
    "shared_dir": "packages/shared",
    "feature_dir": "apps",
    "api_dir": "apps/api",
    "shared_package": "packages/shared",
    "core_package": "packages/core",
    "app_package": "apps/web"
  },
  "codeStyle": [
    "使用命名导出，非默认导出",
    "公共包通过 workspace 协议引用（workspace:*）",
    "类型使用 interface 优先",
    "每个包有独立的 tsconfig.json 和 package.json"
  ],
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev --filter <package>",
    "build": "pnpm build",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck"
  }
}
