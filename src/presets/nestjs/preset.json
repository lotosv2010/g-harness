{
  "name": "nestjs",
  "description": "NestJS 10+ 后端服务预设",
  "techStack": {
    "language": "TypeScript",
    "runtime": "Node.js 20+",
    "framework": "NestJS 10",
    "buildTool": "nest-cli / swc",
    "testRunner": "Jest",
    "packageManager": "pnpm"
  },
  "variables": {
    "shared_dir": "src/common",
    "feature_dir": "src/modules",
    "api_dir": "src/modules",
    "shared_package": "src/common",
    "core_package": "src/core",
    "app_package": "src"
  },
  "codeStyle": [
    "每个业务领域一个 Module，包含 controller/service/entity",
    "使用装饰器风格（@Controller、@Injectable、@Module）",
    "DTO 使用 class-validator + class-transformer 校验",
    "类型使用 interface 优先，DTO 使用 class"
  ],
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm start:dev",
    "build": "pnpm build",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck"
  }
}
