{
  "name": "flutter",
  "description": "Dart + Flutter 跨端移动应用预设",
  "techStack": {
    "language": "Dart 3+",
    "runtime": "Flutter Engine",
    "framework": "Flutter 3",
    "buildTool": "flutter build",
    "testRunner": "flutter test",
    "packageManager": "pub"
  },
  "variables": {
    "shared_dir": "lib/core",
    "feature_dir": "lib/features",
    "api_dir": "lib/data/api",
    "shared_package": "lib/core",
    "core_package": "lib/data",
    "app_package": "lib"
  },
  "codeStyle": [
    "使用 Feature-First 目录结构",
    "状态管理使用 Riverpod / Bloc",
    "Widget 保持小粒度，拆分到独立文件",
    "使用 freezed / json_serializable 生成数据模型",
    "文件名使用 snake_case"
  ],
  "commands": {
    "dev": "flutter run",
    "build:apk": "flutter build apk",
    "build:ios": "flutter build ios",
    "test": "flutter test",
    "lint": "dart analyze",
    "format": "dart format ."
  }
}
