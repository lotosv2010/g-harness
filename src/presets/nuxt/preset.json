{
  "name": "nuxt",
  "description": "Nuxt 3 + Vue 3 全栈应用预设",
  "techStack": {
    "language": "TypeScript",
    "runtime": "Node.js 20+",
    "framework": "Nuxt 3 (Vue 3)",
    "buildTool": "Vite (Nuxt 内置)",
    "testRunner": "Vitest",
    "packageManager": "pnpm"
  },
  "variables": {
    "shared_dir": "composables",
    "feature_dir": "pages",
    "api_dir": "server/api",
    "shared_package": "composables",
    "core_package": "server",
    "app_package": "app"
  },
  "codeStyle": [
    "使用 Composition API + <script setup>",
    "组合式函数使用 use 前缀，放 composables/ 目录",
    "页面组件使用 definePageMeta",
    "API 路由使用 defineEventHandler",
    "类型使用 interface 优先"
  ],
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck"
  }
}
