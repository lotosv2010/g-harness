{
  "name": "express",
  "description": "轻量 Node.js API 预设（Express / Fastify / Hono）",
  "techStack": {
    "language": "TypeScript",
    "runtime": "Node.js 20+",
    "framework": "Express / Fastify / Hono",
    "buildTool": "tsx / tsup",
    "testRunner": "Vitest",
    "packageManager": "pnpm"
  },
  "variables": {
    "shared_dir": "src/shared",
    "feature_dir": "src/modules",
    "api_dir": "src/routes",
    "shared_package": "src/shared",
    "core_package": "src/core",
    "app_package": "src"
  },
  "codeStyle": [
    "使用命名导出，非默认导出",
    "路由处理函数独立抽取为 controller",
    "业务逻辑封装在 service 层",
    "类型使用 interface 优先"
  ],
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck"
  }
}
