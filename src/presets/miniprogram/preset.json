{
  "$schema": "2",
  "name": "miniprogram",
  "label": "微信小程序",
  "description": "微信小程序原生 + TypeScript",
  "techStack": {
    "language": "TypeScript",
    "framework": "WeChat Mini Program",
    "packageManager": "npm"
  },
  "detect": {
    "dependencies": [],
    "files": ["project.config.json", "app.json"]
  },
  "variables": {
    "shared_dir": "utils",
    "routes_dir": "pages"
  },
  "commands": {
    "dev": "npm run dev:mp-weixin",
    "build": "npm run build:mp-weixin"
  },
  "architecture": {
    "overview": "Pages 与 Components 严格分离；全局状态通过 app.globalData 或 mobx-miniprogram",
    "structure": "├── app.ts\n├── pages/\n├── components/\n└── utils/"
  },
  "modules": ["pages", "components", "utils"],
  "rules": [
    "禁止在 Page 中混入通用组件逻辑，统一抽成 Component",
    "网络请求统一走 utils/request.ts 并带错误重试",
    "所有 wx.xxx API 须处理 fail 分支"
  ],
  "nfr": [
    "分包加载关键页面，主包控制在 2MB 以内",
    "使用骨架屏减少空白时间"
  ]
}
