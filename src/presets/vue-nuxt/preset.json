{
  "name": "vue-nuxt",
  "description": "Vue 3 + Nuxt 3 全栈应用预设",
  "techStack": {
    "language": "TypeScript",
    "runtime": "Node.js 20+",
    "framework": "Nuxt 3 (Vue 3)",
    "buildTool": "Vite (Nuxt 内置)",
    "testRunner": "Vitest",
    "packageManager": "pnpm"
  },
  "variables": {
    "shared_dir": "composables",
    "feature_dir": "pages",
    "api_dir": "server/api",
    "core_dir": "server/utils",
    "app_dir": "app",
    "shared_package": "composables",
    "core_package": "server",
    "app_package": "app"
  },
  "codeStyle": [
    "使用 Composition API + <script setup>",
    "组合式函数（composable）使用 use 前缀",
    "类型使用 interface 优先",
    "页面组件使用 definePageMeta"
  ],
  "commands": {
    "install": "pnpm install",
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm test",
    "lint": "pnpm lint",
    "typecheck": "pnpm typecheck"
  }
}
