{
  "$schema": "2",
  "name": "electron",
  "label": "Electron Desktop",
  "description": "Electron + TypeScript + Vite 的跨平台桌面应用",
  "techStack": {
    "language": "TypeScript",
    "framework": "Electron",
    "buildTool": "Vite",
    "testRunner": "Vitest",
    "packageManager": "pnpm"
  },
  "detect": {
    "dependencies": ["electron"],
    "files": ["electron-builder.yml", "electron.vite.config.ts"]
  },
  "variables": {
    "shared_dir": "src/shared"
  },
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "package": "pnpm package",
    "test": "pnpm test"
  },
  "architecture": {
    "overview": "严格隔离 main / preload / renderer 三进程；IPC 通过类型化 channel 通信",
    "structure": "src/\n├── main/\n├── preload/\n├── renderer/\n└── shared/"
  },
  "modules": ["main", "preload", "renderer", "shared", "ipc"],
  "rules": [
    "禁止在 renderer 直接启用 nodeIntegration，必须通过 preload 暴露有限 API",
    "所有 IPC 通道名集中在 shared/ipc-channels.ts 定义",
    "主进程禁止阻塞事件循环的同步任务"
  ],
  "nfr": [
    "启用自动更新（electron-updater）",
    "崩溃上报使用 Electron Crash Reporter"
  ],
  "knowledgeSlug": "electron"
}
