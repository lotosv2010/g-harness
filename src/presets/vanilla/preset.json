{
  "$schema": "2",
  "name": "vanilla",
  "label": "Vanilla JS/TS",
  "description": "无特定框架的 Node / 浏览器脚手架",
  "techStack": {
    "language": "TypeScript",
    "packageManager": "pnpm",
    "testRunner": "Vitest"
  },
  "detect": {
    "dependencies": [],
    "files": ["tsconfig.json"]
  },
  "variables": {
    "shared_dir": "src/shared"
  },
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm test"
  },
  "architecture": {
    "overview": "单入口 + 按职责拆分模块；不引入跨层依赖",
    "structure": "src/\n├── index.ts\n├── core/\n└── shared/"
  },
  "modules": ["core", "shared", "utils"],
  "rules": [
    "使用 ES Modules，禁止 CommonJS 混用",
    "副作用集中在入口，业务函数保持纯"
  ],
  "nfr": ["构建产物需带 source map 以便线上排障"]
}
